<Window x:Class="DocumentIA.Batch.ClassificationLite.Views.InputBoxDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuevo entorno" Height="150" Width="360"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText" Grid.Row="0" Text="Nombre del entorno:" Margin="0,0,0,8"/>
        <TextBox x:Name="ValueBox" Grid.Row="1" Margin="0,0,0,8"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Aceptar" Width="90" Margin="0,0,8,0" Click="Ok_Click" IsDefault="True"/>
            <Button Content="Cancelar" Width="90" Click="Cancel_Click" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
