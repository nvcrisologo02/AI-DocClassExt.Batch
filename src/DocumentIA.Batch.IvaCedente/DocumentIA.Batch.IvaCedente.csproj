<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DocumentIA.Batch.IvaCedente</AssemblyName>
    <RootNamespace>DocumentIA.Batch.IvaCedente</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>GDC SAREB</Authors>
    <Description>Consola headless que detecta IVA y su deducción en el título previo de cada activo mediante DocumentIA.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DocumentIA.Batch.ClassificationLite\DocumentIA.Batch.ClassificationLite.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DocumentIA.Batch.IvaCedente.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="config.sample.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="prompts\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
